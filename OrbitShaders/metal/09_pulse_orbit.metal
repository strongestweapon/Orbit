// Portable scalar/vector subset shared by the Metal and ISF builds.
// u: clockwise around the ring, zero at twelve o'clock. v: inner -> outer.
#define ORBIT_TAU 6.283185307179586
struct OrbitParams {
    float outputWidth;
    float outputHeight;
    float viewMode;
    float phaseTime;
    float density;
    float turbulence;
    float energy;
    float hueShift;
    float brightness;
    float seed;
    float angleOffset;
    float flipU;
    float flipV;
    float ringWidth;
    float testPattern;
    float markerWidth;
    float coverage;
    float gapSoftness;
    float gapMotion;
    float fragmentation;
    // Scene-specific shape controls; see config/scenes.json.
    float shape0;
    float shape1;
    float shape2;
    float shape3;
};

float orbitHash(vec3 p) {
    p = fract(p * 0.1031);
    p += dot(p, p.yzx + 33.33);
    return fract((p.x + p.y) * p.z);
}

float orbitNoise(vec3 p) {
    vec3 i = floor(p);
    vec3 f = fract(p);
    f = f * f * (3.0 - 2.0 * f);
    return mix(
        mix(mix(orbitHash(i), orbitHash(i + vec3(1,0,0)), f.x),
            mix(orbitHash(i + vec3(0,1,0)), orbitHash(i + vec3(1,1,0)), f.x), f.y),
        mix(mix(orbitHash(i + vec3(0,0,1)), orbitHash(i + vec3(1,0,1)), f.x),
            mix(orbitHash(i + vec3(0,1,1)), orbitHash(i + vec3(1,1,1)), f.x), f.y), f.z);
}

float orbitFbm(vec3 p) {
    return 0.57 * orbitNoise(p) + 0.285 * orbitNoise(p * 2.03 + 17.1)
        + 0.145 * orbitNoise(p * 4.11 + 31.7);
}

vec3 orbitCircle(float u, float v, float scale, float t, float seed) {
    float a = ORBIT_TAU * u;
    return vec3(cos(a) * scale, sin(a) * scale, v * 2.6 + t) + seed * 0.371;
}

vec3 orbitHsv(float h, float s, float v) {
    vec3 p = abs(fract(vec3(h) + vec3(0.0, 2.0/3.0, 1.0/3.0)) * 6.0 - 3.0);
    return v * mix(vec3(1.0), clamp(p - 1.0, 0.0, 1.0), s);
}

float orbitDistance(float a, float b) {
    return abs(fract(a - b + 0.5) - 0.5);
}

// Local light occupancy: a moving arc with truly black gaps, never a global strobe.
float orbitLightCenter(OrbitParams p) {
    return 0.66 + p.phaseTime * p.gapMotion * 0.025;
}

float orbitPresence(vec2 uv, OrbitParams p) {
    float fill = clamp(p.coverage, 0.0, 1.0);
    if (fill <= 0.0) return 0.0;
    if (fill >= 1.0) return 1.0;
    float t = p.phaseTime * p.gapMotion;
    float breathing = sin(t * 0.37 + p.seed) * fill * (1.0 - fill) * 0.20;
    float halfWidth = (fill + breathing) * 0.5;
    float feather = min(halfWidth * 0.65, 0.003 + p.gapSoftness * 0.075);
    float d = orbitDistance(uv.x, orbitLightCenter(p));
    float arc = 1.0 - smoothstep(halfWidth - feather, halfWidth + feather, d);
    float islands = orbitNoise(orbitCircle(uv.x - t * 0.016, 0.0,
                                4.0 + p.fragmentation * 16.0, t * 0.22, p.seed + 15.0));
    float threshold = 0.25 + p.fragmentation * 0.24;
    float pieces = smoothstep(threshold - 0.06, threshold + 0.09, islands);
    return arc * mix(1.0, pieces, p.fragmentation);
}

// Canonical shader/texture v runs inner -> outer. The supplied LED layout runs
// raster top -> bottom from outer -> inner, with upright numerals facing the ring center.
// Strip and packed output convert raster Y; ring preview keeps physical radial coordinates.
vec3 orbitCoordinates(vec2 pixel, OrbitParams p) {
    vec2 size = vec2(p.outputWidth, p.outputHeight);
    vec2 uv = pixel / size;
    float coverage = 1.0;
    if (p.viewMode > 1.5) {
        vec2 q = uv * vec2(3840.0, 2160.0);
        float row = floor(q.y / 300.0);
        if (q.x >= 3564.0 || q.y >= 1500.0 || (row > 3.5 && q.x >= 1188.0))
            return vec3(0.0);
        uv = vec2((row * 3564.0 + q.x) / 15444.0, 1.0 - fract(q.y / 300.0));
    } else if (p.viewMode > 0.5) {
        vec2 q = pixel - size * 0.5;
        float outer = min(size.x, size.y) * 0.34722222;
        float inner = outer * (1.0 - clamp(p.ringWidth, 0.01, 0.6));
        float r = length(q);
        coverage = smoothstep(inner - 0.7, inner + 0.7, r)
                 * (1.0 - smoothstep(outer - 0.7, outer + 0.7, r));
        if (coverage <= 0.0) return vec3(0.0);
        uv = vec2(fract(ORBIT_ATAN(q.x, -q.y) / ORBIT_TAU),
                  clamp((r - inner) / (outer - inner), 0.0, 1.0));
    } else {
        uv.y = 1.0 - uv.y;
    }
    uv.x = fract((p.flipU > 0.5 ? -uv.x : uv.x) + p.angleOffset);
    uv.y = p.flipV > 0.5 ? 1.0 - uv.y : uv.y;
    return vec3(uv, coverage);
}

float orbitBandEdge(float v) {
    return smoothstep(0.0, 0.025, v) * (1.0 - smoothstep(0.975, 1.0, v));
}

// Native stateful scene. The host integrates 12 angular particles, then shares
// this same snapshot between the ring, strip, packed output and benchmark.
struct PulseOrbitParams {
    OrbitParams base;
    float position[12];
    float velocity[12];
    float hue[3];
    float simulationTime;
    float dynamics;
    float rhythmRate;
    float afterglow;
    float counterflow;
};

float3 pulseOrbitShade(float2 uv, constant PulseOrbitParams &state) {
    OrbitParams p = state.base;
    int lane = int(clamp(floor(uv.y * 3.0), 0.0, 2.0));
    float center = (float(lane) + 0.5) / 3.0;
    float width = mix(0.035, 0.27, clamp(p.shape3, 0.0, 1.0));
    float radialPixel, angularPixel;
    if (p.viewMode > 1.5) {
        radialPixel = 2160.0 / (p.outputHeight * 300.0);
        angularPixel = 3840.0 / (p.outputWidth * 15444.0);
    } else if (p.viewMode > 0.5) {
        float outer = min(p.outputWidth, p.outputHeight) * 0.34722222;
        float ringWidth = clamp(p.ringWidth, 0.01, 0.6);
        radialPixel = 1.0 / max(outer * ringWidth, 1.0);
        angularPixel = 1.0 / max(ORBIT_TAU * outer * (1.0 - ringWidth + uv.y * ringWidth), 1.0);
    } else {
        radialPixel = 1.0 / p.outputHeight;
        angularPixel = 1.0 / p.outputWidth;
    }
    // Pixel-sized edge coverage, no blur/noise/glow. Same physical line width in every view.
    float radialAA = radialPixel * 0.65;
    float line = 1.0 - smoothstep(width * 0.5 - radialAA, width * 0.5 + radialAA, abs(uv.y - center));
    if (line <= 0.0) return float3(0.0);
    // Each emitter has a bright leading edge and a directional, decaying tail.
    float length = mix(0.012, 0.62, clamp(p.shape1, 0.0, 1.0));
    float count = 1.0 + 3.0 * clamp(p.shape2, 0.0, 1.0);
    float light = 0.0;
    for (int slot = 0; slot < 4; slot++) {
        int index = lane * 4 + slot;
        int rank = slot == 1 ? 2 : (slot == 2 ? 1 : slot);
        float active = clamp(count - float(rank), 0.0, 1.0);
        float proportion = slot == 0 ? 1.0 : (slot == 2 ? 0.72 : (slot == 1 ? 0.42 : 0.27));
        float period = (10.0 - state.rhythmRate * 7.0) * (1.0 + float(lane)*0.09 + float(slot)*0.13);
        float phase = fract(state.simulationTime/period + float(lane)*0.19 + float(slot)*0.27);
        float burst = smoothstep(0.02,0.08,phase) * (1.0-smoothstep(0.30,0.74,phase));
        float life = smoothstep(0.0,0.035,phase) * (1.0-smoothstep(0.66,0.98,phase));
        life = mix(1.0,life,clamp(state.dynamics,0.0,1.0));
        float velocity = state.velocity[index];
        float fallback = (p.density < 0.5 ? -1.0 : 1.0) * (state.counterflow >= 0.5 && lane == 1 ? -1.0 : 1.0);
        float direction = abs(velocity) > 0.0001 ? sign(velocity) : fallback;
        float speed = clamp(abs(velocity)/0.22,0.0,1.0);
        float span = min(0.82,length * proportion * mix(1.0,0.30 + 0.95*burst + 0.75*speed,state.dynamics));
        float behind = fract((state.position[index] - uv.x) * direction);
        float relative = behind / max(span,0.0001);
        float tail = pow(max(0.0,1.0-relative),mix(3.2,0.55,clamp(state.afterglow,0.0,1.0)));
        // A packet can resolve into a train of short dashes, then join into a sweep.
        // It is spatial modulation inside each tail, never a whole-screen strobe.
        float chopped = state.dynamics * smoothstep(0.20,0.80,0.5 + 0.5*sin(state.simulationTime*0.68 + float(lane)*1.8));
        float spacing = mix(0.014,0.045,burst);
        float cell = fract(behind/spacing);
        float cellAA = min(0.12,angularPixel/spacing);
        float dash = smoothstep(0.0,cellAA,cell)*(1.0-smoothstep(0.45-cellAA,0.45+cellAA,cell));
        tail *= mix(1.0,0.08 + 0.92*dash,chopped);
        float distance = abs(fract(uv.x-state.position[index]+0.5)-0.5);
        float head = 1.0-smoothstep(0.004-angularPixel*0.65,0.004+angularPixel*0.65,distance);
        light = max(light,clamp(tail*1.25 + head,0.0,1.0)*life*active);
    }
    // Preserve the existing color slots; restrict the palette to pure red or white.
    float3 color = state.hue[lane] >= 0.5 ? float3(1.0) : float3(1.0, 0.0, 0.0);
    return color * light * line;
}

float4 samplePulseOrbit(float2 pixel, constant PulseOrbitParams &state) {
    OrbitParams p = state.base;
    float3 uv = orbitCoordinates(pixel, p);
    if (uv.z <= 0.0) return float4(0, 0, 0, 1);
    float3 rgb = pulseOrbitShade(uv.xy, state) * p.brightness * orbitPresence(uv.xy, p) * uv.z;
    return float4(clamp(rgb, 0.0, 1.0), 1.0);
}

