{
  "schemaVersion": 1,
  "status": "example bindings; native app supports per-parameter OSC input and MIDI/OSC output",
  "osc": {
    "bindAddress": "0.0.0.0",
    "udpPort": 9000,
    "expectedIntervalSeconds": 30,
    "staleAfterSeconds": 90
  },
