    {
      "id": "racing_speed",
      "address": "/park/racing/speed",
      "argument": 0,
      "type": "float",
      "range": [
        0,
        100
      ]
    },
    {
      "id": "visitors",
      "address": "/park/visitors",
      "argument": 0,
      "type": "int",
      "range": [
        0,
        500
      ]
    }
  ],
